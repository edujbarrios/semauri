# Generate secrets from the operating system's secure random source.
# Run with: semauri run examples/secure_password.suri --allow secure_random --allow console_write

let generated_password be password of 20 characters.
let custom_token be secure random string of 32 characters from "abcdef0123456789".
let six_digit_code be draw random integer from 100000 to 999999.
let selected_letter be pick random character from "ABCD".

print generated_password.
print custom_token.
print six_digit_code.
print selected_letter.
