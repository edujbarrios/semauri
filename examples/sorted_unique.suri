let scores be a list of 3, 1, 3, 2, 1.
assert (sorted distinct of scores) is equal to (a list of 1, 2, 3).
assert (sorted unique of scores) is equal to (a list of 1, 2, 3).
assert (sort distinct of scores) is equal to (a list of 1, 2, 3).
assert (sort unique of scores) is equal to (a list of 1, 2, 3).
assert (length of scores) is equal to 5.
print "Sorted unique OK".
