# Drop repetitions while preserving the first occurrence and original input.
let predictions be a list of 3, 1, 3, 2, 1.
let unique be distinct of predictions.
let ordered_unique be sorted of unique.
assert length of unique is equal to 3.
assert (unique at 0) is equal to 3.
assert (ordered_unique at 0) is equal to 1.
print ordered_unique.
