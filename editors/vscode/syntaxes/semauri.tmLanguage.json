{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Semauri",
  "scopeName": "source.semauri",
  "fileTypes": [
    "suri"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#config"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#control"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#ai"
    },
    {
      "include": "#collections"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#domains"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.semauri",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.semauri",
          "match": "//.*$"
        },
        {
          "name": "comment.block.semauri",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.semauri",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.triple.single.semauri",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.semauri",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.semauri",
              "match": "\\\\(?:[\\\\'\"nrt0bfave]|x[0-9A-Fa-f]{2}|U[0-9A-Fa-f]{8}|u(?:[0-9A-Fa-f]{4}|\\{[0-9A-Fa-f]{1,6}\\}))"
            },
            {
              "name": "invalid.illegal.escape.semauri",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.semauri",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.semauri",
              "match": "\\\\(?:[\\\\'\"nrt0bfave]|x[0-9A-Fa-f]{2}|U[0-9A-Fa-f]{8}|u(?:[0-9A-Fa-f]{4}|\\{[0-9A-Fa-f]{1,6}\\}))"
            },
            {
              "name": "invalid.illegal.escape.semauri",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.semauri",
          "begin": "[rR]\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.raw.semauri",
          "begin": "[rR]'",
          "end": "'"
        },
        {
          "name": "string.quoted.double.raw.hash.semauri",
          "begin": "[rR](#+)\"",
          "end": "\"\\1"
        },
        {
          "name": "string.quoted.single.raw.hash.semauri",
          "begin": "[rR](#+)'",
          "end": "'\\1"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.semauri",
      "match": "(?<![A-Za-z0-9_])(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[zZ][0-9A-Za-z](?:_?[0-9A-Za-z])*|\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(?![A-Za-z0-9_])"
    },
    "config": {
      "patterns": [
        {
          "name": "keyword.declaration.config.semauri",
          "match": "\\b(?:parameter|environment)\\b(?=\\s+[A-Za-z_])"
        },
        {
          "name": "keyword.operator.assignment.config.semauri",
          "match": "="
        }
      ]
    },
    "constants": {
      "name": "constant.language.semauri",
      "match": "\\b(?:true|false)\\b"
    },
    "types": {
      "name": "storage.type.semauri",
      "match": "\\b(?:number|string|boolean|color|list|language_model|vision_model|response|embedding|tool|agent)\\b"
    },
    "control": {
      "name": "keyword.control.semauri",
      "match": "\\b(?:if|when|unless|otherwise|elif|then|do|end|for|every|each|in|within)\\b"
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.function.semauri",
          "match": "\\b(?:define\\s+function|taking|invoke)\\b"
        },
        {
          "name": "keyword.declaration.semauri",
          "match": "\\b(?:let|be|create|make|set|add|called|title|declare|import|as)\\b"
        }
      ]
    },
    "ai": {
      "name": "support.function.ai.semauri",
      "match": "\\b(?:cap|reattempt|memoize|connect|activate|prompt|inspect|embed|compose|ask|bound|report|constrain|reset|restrict|validate|normalize)\\b"
    },
    "collections": {
      "name": "support.function.collection.semauri",
      "match": "\\b(?:length|reverse|sum|average|minimum|maximum|median|sorted|ascending|descending|distinct|first|last|take|drop|top|bottom|uppercase|lowercase|capitalize|swapcase|uncapitalize|titlecase|trim|words|lines|character|characters|codepoint|codepoints|json|decode|keys|has|key|field|pointer|occurrences|position|positions|remove|split|join|parse|contains|range|map|filter|count|reduce|zip|partition|flatten|repeat|product|absolute|difference|between|squared|squares|root|rms|rmse|mse|running|cumulative|adjacent|successive|differences|mbe|mae|bias|magnitude|magnitudes|error|sign|floor|ceiling|round|truncate|factorial|square|cube|prime|sqrt|cbrt|reciprocal|digits|binary|octal|hex|hexadecimal|even|odd|any|all|exp|ln|log2|log10|sin|cos|asin|acos|atan|sinh|cosh|tanh|asinh|acosh|atanh|log1p|expm1|len|abs|mean|min|max|strip|upper|lower|avg|var|stddev|total|size|unique|cardinality|head|final|med|prod|rev|sort|flat)\\b"
    },
    "operators": {
      "name": "keyword.operator.word.semauri",
      "match": "\\b(?:is|greater|less|than|equal|does|start|contain|include|includes|excludes|divisible|multiple|one|least|most|above|below|empty|blank|zero|positive|negative|nonzero|nonnegative|nonpositive|prime|even|odd|different|joined|starts|ends|begins|finishes|begin|finish|with|and|or|not|plus|minus|times|divided|modulo|by|of|to|from|at)\\b"
    },
    "domains": {
      "name": "support.namespace.semauri",
      "match": "\\b(?:ai|config|console|filesystem|ml|structured_data|web)\\b"
    }
  }
}
